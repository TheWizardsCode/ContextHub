{
  "name": "@worklog/shared",
  "version": "1.0.0",
  "description": "Shared data access layer for Worklog — canonical WorklogDatabase class and type definitions",
  "type": "module",
  "main": "./dist/database.js",
  "types": "./dist/database.d.ts",
  "exports": {
    ".": {
      "types": "./dist/database.d.ts",
      "import": "./dist/database.js"
    },
    "./types": {
      "types": "./dist/types.d.ts",
      "import": "./dist/types.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "clean": "rm -rf dist",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "worklog",
    "shared",
    "database"
  ],
  "license": "MIT",
  "dependencies": {
    "better-sqlite3": "^12.6.2"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^20.10.5",
    "typescript": "^5.3.3"
  }
}
