{
  "suiteCommands": [
    "npm --silent test -- tests",
    "npm --silent test -- packages/shared",
    "npm --silent test -- packages/tui/extensions"
  ],
  "timeoutPerCommand": 3600,
  "groups": {
    "herdr": {
      "commands": [
        "npm --silent test -- packages/herdr/src"
      ],
      "paths": [
        "packages/herdr/**"
      ]
    },
    "tui-extensions": {
      "commands": [
        "npm --silent test -- packages/tui/extensions"
      ],
      "paths": [
        "packages/tui/extensions/**"
      ]
    }
  }
}
