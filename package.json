{
  "name": "worklog",
  "version": "1.0.0",
  "description": "A simple experimental issue tracker for AI agents",
  "main": "dist/index.js",
  "type": "module",
  "bin": {
    "worklog": "./dist/cli.js",
    "wl": "./dist/cli.js"
  },
  "scripts": {
    "build": "tsc && node ./scripts/generate-version.cjs",
    "dev": "tsx watch src/index.ts",
    "prestart": "npm run build",
    "start": "node dist/index.js",
    "cli": "tsx src/cli.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:tui": "bash ./tests/tui-ci-run.sh",
    "tui:prototype": "tsx src/tui/prototype/cli.tsx",
    "tui:prototype:demo": "TUI_DEMO=1 tsx src/tui/prototype/cli.tsx",
    "test:timings": "node ./scripts/test-timings.cjs",
    "benchmark:sort-index": "tsx scripts/benchmark-sort-index.ts"
  },
  "keywords": [
    "worklog",
    "issue-tracker",
    "typescript"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "better-sqlite3": "^12.6.2",
    "chalk": "^5.6.2",
    "blessed": "^0.1.81",
    "commander": "^11.1.0",
    "express": "^4.18.2",
    "js-yaml": "^4.1.1"
  },
  "devDependencies": {
    "@types/blessed": "^0.1.7",
    "@types/better-sqlite3": "^7.6.13",
    "@types/chalk": "^0.4.31",
    "@types/commander": "^2.12.0",
    "@types/express": "^4.17.21",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^20.10.5",
    "@vitest/ui": "^4.0.18",
    "execa": "^7.1.1",
    "tsx": "^4.7.0",
    "typescript": "^5.3.3",
    "vitest": "^4.0.18",
    "ink": "^3.0.8",
    "ink-text-input": "^5.0.1",
    "ink-testing-library": "^3.0.0",
    "@testing-library/react": "^14.0.0"
    ,"react": "^18.2.0",
    "react-dom": "^18.2.0"
  }
}
